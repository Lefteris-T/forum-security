FORUM_HTTPS_ENABLED=false
FORUM_TLS_CERT_FILE=
FORUM_TLS_KEY_FILE=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local callback: http://localhost:8080/auth/github/callback
GITHUB_REDIRECT_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local callback: http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_URL=

# Docker certificate group; replace with the output of: id -g
FORUM_CERT_GID=1000

GITHUB_REDIRECT_URL=https://localhost:8443/auth/github/callback
GOOGLE_REDIRECT_URL=https://localhost:8443/auth/google/callback