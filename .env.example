FORUM_ADDRESS=:8443
FORUM_DATABASE_PATH=data/forum.db
FORUM_SESSION_DURATION=24h
FORUM_COOKIE_NAME=forum_session
FORUM_SECURE_COOKIE=true
FORUM_HTTPS_ENABLED=true
FORUM_TLS_CERT_FILE=certs/localhost.crt
FORUM_TLS_KEY_FILE=certs/localhost.key

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set this only when GitHub OAuth credentials are also configured.
# GITHUB_REDIRECT_URL=https://localhost:8443/auth/github/callback
GITHUB_REDIRECT_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this only when Google OAuth credentials are also configured.
# GOOGLE_REDIRECT_URL=https://localhost:8443/auth/google/callback
GOOGLE_REDIRECT_URL=

# Docker certificate group; replace with the output of: id -g
FORUM_CERT_GID=1000
